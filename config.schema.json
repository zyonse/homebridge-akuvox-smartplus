{
  "pluginAlias": "AkuvoxSmartPlus",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "SmartPlus allows one app session per account, so signing in here will sign out the SmartPlus phone app. A separate family-member account avoids that.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "condition": {
          "functionBody": "return 0"
        },
        "default": "Akuvox SmartPlus",
        "required": true,
        "description": "You shouldn't need to change this."
      },
      "options": {
        "title": "SmartPlus App Login",
        "type": "object",
        "required": true,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string",
            "required": true
          },
          "password": {
            "title": "Password",
            "type": "string",
            "required": true,
            "x-schema-form": {
              "type": "password"
            }
          },
          "region": {
            "title": "Region",
            "type": "string",
            "default": "ucloud",
            "oneOf": [
              { "title": "North America", "enum": ["ucloud"] },
              { "title": "Europe / Global", "enum": ["ecloud"] },
              { "title": "Asia Pacific", "enum": ["scloud"] },
              { "title": "Oceania", "enum": ["aucloud"] },
              { "title": "China", "enum": ["ccloud"] },
              { "title": "Japan", "enum": ["jcloud"] },
              { "title": "Russia", "enum": ["rucloud"] }
            ]
          }
        }
      },
      "defaultType": {
        "title": "Show doors as",
        "type": "string",
        "default": "garage",
        "oneOf": [
          { "title": "Garage door", "enum": ["garage"] },
          { "title": "Momentary switch (no confirmation for automations)", "enum": ["switch"] },
          { "title": "Lock", "enum": ["lock"] }
        ]
      },
      "openDuration": {
        "title": "Seconds to show as open after triggering",
        "description": "SmartPlus doesn't report door position. Defaults: garage 60, switch 1, lock 10.",
        "type": "number",
        "minimum": 0.5
      },
      "onlyListedDoors": {
        "title": "Only add doors listed below",
        "description": "Useful for community accounts with many building doors.",
        "type": "boolean",
        "default": false
      },
      "doors": {
        "title": "Per-door settings",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Door name, device name, or mac:relay id (as printed by the login command)",
              "type": "string",
              "required": true
            },
            "type": {
              "title": "Show as",
              "type": "string",
              "oneOf": [
                { "title": "Garage door", "enum": ["garage"] },
                { "title": "Momentary switch", "enum": ["switch"] },
                { "title": "Lock", "enum": ["lock"] }
              ]
            },
            "openDuration": {
              "title": "Seconds to show as open",
              "type": "number",
              "minimum": 0.5
            },
            "hidden": {
              "title": "Hide from HomeKit",
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "cameras": {
        "title": "Cameras",
        "description": "Intercom cameras to add to HomeKit. Device names and ids are logged when Homebridge starts.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Device name or id (MAC)",
              "type": "string",
              "required": true
            }
          }
        }
      },
      "videoEncoder": {
        "title": "Camera video encoder",
        "type": "string",
        "default": "libx264",
        "oneOf": [
          { "title": "Software (libx264)", "enum": ["libx264"] },
          { "title": "macOS hardware (h264_videotoolbox)", "enum": ["h264_videotoolbox"] },
          { "title": "Raspberry Pi hardware (h264_v4l2m2m)", "enum": ["h264_v4l2m2m"] },
          { "title": "No transcoding (copy)", "enum": ["copy"] }
        ],
        "description": "No transcoding uses the least CPU but always sends the camera's 720p stream."
      },
      "videoProcessor": {
        "title": "ffmpeg path",
        "type": "string",
        "placeholder": "bundled ffmpeg-for-homebridge",
        "description": "Only set this to use a different ffmpeg build."
      }
    }
  }
}
